# Copy this file to `.env` and fill in the real values. `.env` is never committed.
# The AI agent adds a line here (name only, no real value) every time a new secret is needed,
# with a comment saying where to get it.
{% if "Supabase" in (s.database or "") %}
# Supabase → Project Settings → API
{{ p.public_env_prefix }}SUPABASE_URL=
{{ p.public_env_prefix }}SUPABASE_ANON_KEY=        # safe for the browser ONLY because Row Level Security is on
SUPABASE_SERVICE_ROLE_KEY=        # server only — never use in browser code
{% endif %}{% if s.uses_ai == "Yes" %}
# AI provider API key (server only)
AI_API_KEY=
{% endif %}{% if s.monetization and s.monetization != "Free" %}
# Stripe → Developers → API keys (use TEST keys until launch)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
{% endif %}