# ---- Interviewer LLM -------------------------------------------------------
# mock   = scripted questions from interview/question_bank.yaml (no AI, great for UI dev + tests)
# openai = any OpenAI-compatible /chat/completions endpoint (Ollama, vLLM, LM Studio, hosted APIs)
LLM_PROVIDER=mock
LLM_BASE_URL=http://localhost:11434/v1     # Ollama's OpenAI-compatible endpoint
LLM_API_KEY=ollama                          # any string for Ollama; real key for hosted APIs
LLM_MODEL=qwen3:8b                          # pick an instruct model that reliably returns JSON
LLM_JSON_MODE=true                          # send response_format=json_object (turn off if your server rejects it)

# ---- Speech-to-text ---------------------------------------------------------
# browser = transcribe in the browser (Web Speech API) — zero setup, Chrome/Edge best
# local   = faster-whisper on this machine (pip install faster-whisper)
# remote  = an OpenAI-compatible /audio/transcriptions server (e.g. a self-hosted Whisper server)
STT_PROVIDER=browser
STT_MODEL=large-v3-turbo                    # local: any faster-whisper model name or HF repo id
STT_DEVICE=auto                             # auto | cpu | cuda
STT_COMPUTE_TYPE=int8                       # int8 (CPU friendly) | float16 (GPU)
STT_REMOTE_URL=http://localhost:9000/v1
STT_REMOTE_API_KEY=
STT_LANGUAGE=                               # empty = auto-detect

# ---- Storage ----------------------------------------------------------------
SKILLTALK_HOME=~/.skilltalk                 # finished skills saved to $SKILLTALK_HOME/skills/<name>/
SAVE_AUDIO=false                            # never keep user audio unless they opt in
