# Copy this file to `.env` and fill in the real values. `.env` is never committed.
# The AI agent adds a line here (name only, no real value) every time a new secret is needed,
# with a comment saying where to get it.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=        # safe for the browser ONLY because Row Level Security is on
SUPABASE_SERVICE_ROLE_KEY=        # server only — never use in browser code
